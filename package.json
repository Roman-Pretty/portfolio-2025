{
    "name": "frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc && vite build",
        "build-windows": "vue-tsc && vite build",
        "build-ghpages": "vue-tsc && vite build && copy index.html dist\\404.html",
        "preview": "vite preview",
        "deploy": "npm run build-ghpages && git add dist && git commit -m \"adding dist subtree\" && git subtree push --prefix dist origin gh-pages"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "aos": "^2.3.4",
        "lucide-vue-next": "^0.473.0",
        "tailwindcss": "^4.0.0",
        "vue": "^3.5.5",
        "vue-carousel-3d": "^1.0.1",
        "vue3-carousel": "^0.13.0"
    },
    "devDependencies": {
        "@types/aos": "^3.0.7",
        "@vitejs/plugin-vue": "^5.1.3",
        "daisyui": "^5.0.0-beta.2",
        "typescript": "^5.6.2",
        "vite": "^5.4.5",
        "vue-tsc": "^2.1.6"
    }
}
